# Cloudflare -> Caddy -> web / api. Cloudflare SSL mode must be "Full (strict)".
{
	servers {
		# Trust forwarding headers only from Cloudflare. Re-check https://www.cloudflare.com/ips/ when
		# Cloudflare announces changes, and keep the VM firewall limited to these ranges on 80/443.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		# Cloudflare overwrites this header, so the user cannot fake it (unlike X-Forwarded-For).
		client_ip_headers CF-Connecting-IP
	}
}

{$SITE_DOMAIN} {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Django serves only its admin, static files and health checks publicly. The app itself talks
	# to Django through the web container's proxy on the private network.
	@django path /admin/* /static/* /healthz /readyz
	handle @django {
		reverse_proxy api:8000 {
			# Replace, never append: the first X-Forwarded-For entry is what Django trusts.
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		reverse_proxy web:3000 {
			header_up X-Seatlock-Client-Ip {client_ip}
			header_up X-Forwarded-For {client_ip}
		}
	}

	log {
		output stdout
		format json
	}
}
