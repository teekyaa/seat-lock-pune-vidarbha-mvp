# Copy to deploy/.env on the VM (chmod 600). Never commit the real file.
# Generate passwords with: openssl rand -hex 32  (hex, so they are safe inside the URLs below)

SITE_DOMAIN=seatlock.example.in

# --- Containers ---
POSTGRES_PASSWORD=
REDIS_PASSWORD=
KAFKA_CLUSTER_ID=

# --- Django (read by api, scheduler, relay, consumer-metrics) ---
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=seatlock.example.in,api
DJANGO_CSRF_TRUSTED_ORIGINS=https://seatlock.example.in
DJANGO_TRUST_PROXY_HEADERS=1
# Cloudflare and Caddy enforce HTTPS; Django is never reachable from outside, and the web container
# calls it over plain HTTP on the private network, so Django must not redirect those calls.
DJANGO_SECURE_SSL_REDIRECT=0
# Write the same passwords out in full here; env files are not expanded.
DATABASE_URL=postgres://seatlock:SAME_AS_POSTGRES_PASSWORD@db:5432/seatlock
REDIS_URL=redis://:SAME_AS_REDIS_PASSWORD@redis:6379/0
WEB_BASE_URL=https://seatlock.example.in
# Caddy (172.28.0.2) and web (172.28.0.10) are the only proxies allowed to pass client IPs.
OTP_TRUSTED_PROXY_IPS=172.28.0.2,172.28.0.10

# --- Kafka ---
KAFKA_ENABLED=1
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- Admin ---
ADMIN_DASHBOARD_ENABLED=1
ADMIN_TOTP_ENCRYPTION_KEY=
# Turn on (1) only with ADMIN_IP_ALLOWLIST set; production refuses to start otherwise.
DJANGO_LEGACY_ADMIN_ENABLED=0
# Your own IP(s) for /admin/ (route legs, abuse flags).
ADMIN_IP_ALLOWLIST=

# --- OTP senders ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
VERIFYNOW_CUSTOMER_ID=
VERIFYNOW_AUTH_KEY=

# --- Email (Brevo SMTP) and Web Push ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Seat Lock <no-reply@seatlock.example.in>
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@seatlock.example.in

# --- Pickup search ---
MAPPLS_API_KEY=

# --- Backups (deploy/backup.sh) ---
BACKUP_PASSPHRASE=
RCLONE_REMOTE=r2:seatlock-backups
