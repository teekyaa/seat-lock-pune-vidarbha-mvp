# Copy to .env for local development. In production set these as real environment variables.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.com
# Legacy Django admin defaults to enabled only in DEBUG; it does not enforce operator TOTP.
# DJANGO_LEGACY_ADMIN_ENABLED=0
# In production the new admin API is disabled by default; enable only after security review.
# ADMIN_DASHBOARD_ENABLED=1
# ADMIN_TOTP_ENCRYPTION_KEY=   # Fernet key from a secret manager; never commit it.
# ADMIN_IP_ALLOWLIST=203.0.113.0/24  # Optional; configure trusted proxy IP handling first.
# Set only behind a trusted proxy that removes client-supplied forwarding headers.
# DJANGO_TRUST_PROXY_HEADERS=1
# PostgreSQL 16. Leave unset to use local SQLite (no row locking).
# DATABASE_URL=postgres://seatlock:seatlock@127.0.0.1:5432/seatlock
# REDIS_URL=redis://127.0.0.1:6379/0
WEB_BASE_URL=http://localhost:3000
# OTP senders are tried in order: WhatsApp, then VerifyNow SMS, then TextBee, using whichever are
# configured. Keep every credential in api/.env or the host's secret store only.
# WhatsApp Cloud API (Meta): an approved "authentication" template with a copy-code button.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_OTP_TEMPLATE=seatlock_login_code
# WHATSAPP_OTP_LANGUAGE=en
# WHATSAPP_GRAPH_VERSION=v27.0
# Message Central VerifyNow SMS (no own DLT registration needed). The key is the Base64 value from its console.
# VERIFYNOW_CUSTOMER_ID=
# VERIFYNOW_AUTH_KEY=
# TextBee Android gateway (development and testing only).
# TEXTBEE_API_KEY=
# TEXTBEE_DEVICE_ID=
# With any real sender configured, OTP_DEBUG_ECHO is disabled even when DJANGO_DEBUG=1.
OTP_DEBUG_ECHO=0
# Optional explicit order, comma separated dotted paths. Overrides the automatic choice above.
# OTP_BACKENDS=apps.notifications.whatsapp.WhatsAppOTPBackend,apps.notifications.verifynow.VerifyNowSMSBackend
# Domain events to Kafka (docs/EVENTS_KAFKA.md). Off locally; the deploy compose file turns it on.
# KAFKA_ENABLED=1
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Codes sent per hour across all users before new requests are refused (spend cap).
# OTP_GLOBAL_SENDS_PER_HOUR=300
# Use the REDIS_URL above for shared phone/IP limits in a multi-process deployment.
# Trust X-Forwarded-For only when Django receives traffic from these known proxy IPs.
# OTP_TRUSTED_PROXY_IPS=
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Seat Lock <no-reply@example.com>
# Web Push. Generate with: uv run vapid --gen  (from py-vapid, installed with pywebpush)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.com

# Mappls (MapmyIndia) key for exact pickup search and measuring route legs. Keep it in api/.env only.
# MAPPLS_API_KEY=
