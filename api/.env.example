# Copy to .env for local development. In production set these as real environment variables.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.com
# PostgreSQL 16. Leave unset to use local SQLite (no row locking).
# DATABASE_URL=postgres://seatlock:seatlock@127.0.0.1:5432/seatlock
# REDIS_URL=redis://127.0.0.1:6379/0
WEB_BASE_URL=http://localhost:3000
# Development only: return the OTP in the API response.
OTP_DEBUG_ECHO=1
# SMS_BACKEND=apps.notifications.channels.ConsoleSMSBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Seat Lock <no-reply@example.com>
# Web Push. Generate with: uv run vapid --gen  (from py-vapid, installed with pywebpush)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.com
